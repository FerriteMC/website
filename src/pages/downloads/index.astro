---
import SoftwarePreview, { SoftwarePreviewType } from "@/components/data/SoftwarePreview.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Downloads"
  description="Find downloads for our software – including Papercut, Blocklest, Relay, and Velonation."
  keywords={["ferritemc", "minecraft", "performance", "papercut", "relay", "blocklest", "velonation", "downloads"]}
  canonical="/downloads"
>
  <header class="mx-auto flex max-w-4xl flex-col items-center gap-2 px-4 pt-32 pb-16 lg:pt-28 lg:pb-12">
    <h1 class="text-4xl leading-normal font-medium lg:text-5xl lg:leading-normal">Downloads</h1>
    <p class="mb-6 text-center text-xl">
      {"Select the software you want to download."}
    </p>
    <h2 class="mt-4 text-center text-2xl font-medium">Server Software</h2>
    <div class="grid gap-2 px-2 md:grid-cols-2 xl:gap-4">
      <SoftwarePreview
        id="papercut"
        name="Papercut"
        icon="brand/papercut"
        description="Papercut is a Rust-powered Minecraft game server, designed to greatly improve performance and offer more advanced features and API."
        type={SoftwarePreviewType.Download}
      />
      <SoftwarePreview
        id="blocklest"
        name="Blocklest"
        icon="brand/blocklest"
        description="Blocklest is a new fork of Papercut that adds regionized multithreading to the server."
        type={SoftwarePreviewType.Download}
      />
      <SoftwarePreview
        id="void"
        name="Void"
        icon="brand/void"
        description="Void is a lightweight limbo server replacement for NanoLimbo, forked from Blocklest with stripped features. Coming soon."
        type={SoftwarePreviewType.Download}
        eol
      />
    </div>
    <h2 class="mt-4 text-center text-2xl font-medium">Proxy Software</h2>
    <div class="grid gap-2 px-2 md:grid-cols-2 xl:gap-4">
      <SoftwarePreview
        id="relay"
        name="Relay"
        icon="brand/relay"
        description="Relay is the modern, high-performance Minecraft server proxy."
        type={SoftwarePreviewType.Download}
      />
      <SoftwarePreview
        id="velonation"
        name="Velonation"
        icon="brand/velonation"
        description="Velonation is a legacy drop-in Velocity replacement with some additional improvements to performance and stability."
        type={SoftwarePreviewType.Download}
        eol
      />
    </div>
  </header>
</Layout>
