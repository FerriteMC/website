---
import Layout from "@/layouts/Layout.astro";
import SoftwareHeader from "@/components/layout/SoftwareHeader.astro";
import Button from "@/components/input/Button.astro";

import VelocityImage from "@/assets/images/velocity.png";
import CommunityImage from "@/assets/images/community.png";

import { Image } from "astro:assets";
---

<Layout
  title="Velonation"
  description="Velonation is an upgraded Velocity, offering full compatibility with improvements to performance and stability."
  keywords={["velonation", "proxy", "minecraft", "performance", "velocity", "fork"]}
  canonical="/software/velonation"
>
  <SoftwareHeader id="velonation" name="Velonation" icon="brand/velonation" eol>
    <span slot="header">Velonation has reached end of life</span>
    <span slot="description"
      >We recommend you transition to <a href="/software/relay" class="text-rust-500 hover:text-rust-400 hover:underline">Relay</a>.
      For more information see the <a
        href="/news/announcing-the-end-of-life-of-waterfall/"
        class="text-rust-500 hover:text-rust-400 hover:underline">announcement</a
      >. Archived Velonation builds and docs are available here.</span
    >
  </SoftwareHeader>
  <section id="facts" class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-8 md:gap-12 md:py-16">
    <div class="flex flex-col items-center gap-6 md:flex-row md:gap-8 xl:gap-24">
      <div class="relative aspect-video w-full flex-1 overflow-clip rounded-xl bg-gray-900">
        <Image alt="Relay" src={VelocityImage} class="h-full w-full object-cover" />
      </div>
      <div class="flex-1">
        <h2 class="text-2xl font-semibold md:text-4xl">Need an updated proxy? Use Relay!</h2>
        <p class="mt-3 text-gray-900 md:mt-6 md:text-xl dark:text-gray-100">
          All the experience the FerriteMC team has gained from working on Velonation has applied to Relay. Designed with performance and
          scalability in mind, Relay is the best proxy software available.
        </p>
        <div class="mt-8 flex flex-row gap-4">
          <Button variant="filled" href="/software/relay" dense> Learn more </Button>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-center gap-6 md:flex-row-reverse md:gap-8 xl:gap-24">
      <div class="flex-1">
        <h2 class="text-2xl font-semibold md:text-4xl">Together with a community of server owners</h2>
        <p class="mt-3 text-gray-900 md:mt-6 md:text-xl dark:text-gray-100">
          Whether you need help with your proxy settings, server lag, or need a guide for formatting your chat, our knowledgeable staff and
          friendly community are always around to lend a hand.
        </p>
        <div class="mt-8 flex flex-row gap-4">
          <Button variant="filled" href="https://discord.gg/ferritemc" external dense> Join our Discord </Button>
        </div>
      </div>
      <div class="relative aspect-video w-full flex-1 overflow-clip rounded-xl">
        <Image alt="Community" src={CommunityImage} class="h-full w-full object-cover" />
      </div>
    </div>
  </section>
</Layout>
